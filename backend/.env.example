# Copiem este ficheiro para .env e ajustem os valores.
# O .env NÃO vai para o GitHub (está no .gitignore).

PORT=3000

# MySQL do XAMPP: utilizador root sem palavra-passe
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=whoplay

# Texto secreto usado para assinar os tokens de sessão (JWT).
# Usem um texto comprido e diferente em produção.
JWT_SECRET=troquem-isto-por-um-texto-secreto-comprido
JWT_EXPIRES_IN=7d
